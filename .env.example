# Copia este archivo a .env y rellena los valores. .env NO se sube a git.

# Base de datos (la usa docker-compose y la aplicación)
DB_NAME=futboldb
DB_USER=futboldb
DB_PORT=5433
DB_PASSWORD=

# Clave para firmar los JWT, mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_SECRET=

# Opcional: clave propia de TheSportsDB (por defecto se usa la clave de prueba pública)
# THESPORTSDB_API_KEY=
